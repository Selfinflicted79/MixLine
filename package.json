{
  "name": "mixline",
  "version": "0.2.19",
  "private": true,
  "description": "A small desktop mixing board for mic, PC, and app audio",
  "author": "MixLine",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4317",
    "dev:electron": "concurrently -k \"vite --port 4317\" \"wait-on http://127.0.0.1:4317 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4317",
    "electron": "electron .",
    "build:capture": "scripts\\build-capture.bat",
    "dist:win": "npm run build:capture && npm run build && electron-builder --win portable --x64",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.mixline.app",
    "productName": "MixLine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/mixline-capture.exe",
        "to": "mixline-capture.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MixLine-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "MixLine-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.1.12",
    "wait-on": "^9.0.1"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
